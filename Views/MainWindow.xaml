<Window x:Class="tpfred.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:tpfred.Converters"
        xmlns:properties="clr-namespace:tpfred.Properties"

        Title="Élections Québec"
        Height="500" Width="900">

    <Window.Resources>
        <!-- Converter pour afficher Oui/Non -->
        <conv:BooleanToOuiNonConverter x:Key="BoolToOuiNon"/>
    </Window.Resources>

    <DockPanel>

        <!-- Menu principal -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Configuration" Click="Configuration_Click"/>
        </Menu>

        <!-- Barre d’actions en haut -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="10">
            <Button Content="{x:Static properties:Traduction.BtnAjouter}" Click="Ajouter_Click" Margin="0,0,12,0"/>
            <Button Content="{x:Static Properties:Traduction.BtnEffacer}" Click="Effacer_Click" Margin="0,0,12,0"/>

            <TextBlock Text="Décompte " VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Total}" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
            <CheckBox Content="Illégales seulement"
                      Command="{Binding ToggleFiltreCommand}"
                      Margin="20,0,0,0"
                      VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Tableau des contributions -->
        <DataGrid ItemsSource="{Binding Contributions}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="10">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}"/>
                <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}"/>
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}"/>
                <DataGridTextColumn Header="Montant" Binding="{Binding Montant}"/>
                <DataGridTextColumn Header="Nb. Versements" Binding="{Binding NbVersements}"/>
                <DataGridTextColumn Header="Municipalité" Binding="{Binding Municipalite}"/>
                <DataGridTextColumn Header="Code postal" Binding="{Binding CodePostal}"/>
                <DataGridTextColumn Header="Parti" Binding="{Binding Parti}"/>
                <DataGridTextColumn Header="Candidat" Binding="{Binding Candidat}"/>
                <DataGridTextColumn Header="Date événement" Binding="{Binding DateEvenement}"/>
                <DataGridTextColumn Header="Année financière" Binding="{Binding AnneeFinanciere}"/>
                <DataGridTextColumn Header="Illégale ?" 
                                    Binding="{Binding EstIllegale, Converter={StaticResource BoolToOuiNon}}"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
