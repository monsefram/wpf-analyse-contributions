<Window x:Class="tpfred.Views.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration"
        Height="250" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Margin="20">

        <!-- Choix de langue -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Langue :" VerticalAlignment="Center" Width="100"/>
            <ComboBox x:Name="LangueComboBox" Width="150" SelectedIndex="0">
                <ComboBoxItem Content="Français"/>
                <ComboBoxItem Content="English"/>
            </ComboBox>
        </StackPanel>

        <!-- Option redémarrage -->
        <CheckBox x:Name="ChkRestart" Content="Redémarrer après changements :" Margin="0,0,0,20"/>

        <!-- Boutons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Sauvegarder" Width="100" Margin="0,0,10,0" Click="Sauvegarder_Click"/>
            <Button Content="Annuler" Width="100" Click="Annuler_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
